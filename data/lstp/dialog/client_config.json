{
    "type": "minecraft:multi_action",
    "title": [
        {"translate": "selectWorld.dataPacks","color": "gray"},
        {"text": " > ","color": "dark_gray"},
        {"translate": "menu.lstp.lodestone_tp","fallback": "Lodestone TP","color": "gray"},
        {"text": " > ","color": "dark_gray"},
        {"text": "Preferences","color": "white"}
    ],
    "actions": [
        {
            "label": [{"sprite": "minecraft:mob_effect/nausea","atlas": "minecraft:gui"},{"text":" Toggle Screen Wobble"}],
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger lstp.menu.trigger set 1"
            },
            "tooltip": "Toggle charge animation nausea effect"
        },
        {
            "label": [{"sprite": "minecraft:mob_effect/night_vision","atlas": "minecraft:gui"},{"text":" Toggle Teleport Flash"}],
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger lstp.menu.trigger set 2"
            },
            "tooltip": "Toggle post-teleport blindness effect"
        },
        {
            "label": [{"sprite": "minecraft:item/spyglass","atlas": "minecraft:items"},{"text":" Toggle Screen Zoom"}],
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger lstp.menu.trigger set 3"
            },
            "tooltip": "Toggle charge animation FOV change"
        },
        {
            "label": [{"sprite": "minecraft:item/iron_boots","atlas": "minecraft:items"},{"text":" Toggle Sneak Requirement"}],
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger lstp.menu.trigger set 4"
            },
            "tooltip": "Toggle the sneak requirement to teleport"
        },
        {
            "label": [{"sprite": "minecraft:item/oak_sign","atlas": "minecraft:items"},{"text":" Toggle Compass Name"}],
            "action": {
                "type": "minecraft:run_command",
