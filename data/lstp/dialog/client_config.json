{
    "type": "minecraft:multi_action",
    "title": [
        {"translate": "selectWorld.dataPacks","color": "gray"},
        {"text": " > ","color": "dark_gray"},
        {"translate": "menu.lstp.lodestone_tp","fallback": "Lodestone TP","color": "gray"},
        {"text": " > ","color": "dark_gray"},
        {"text": "Preferences","color": "white"}
    ],
    "actions": [
        {
            "label": [{"sprite": "minecraft:mob_effect/nausea","atlas": "minecraft:gui"},{"text":" Toggle Screen Wobble"}],
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger lstp.menu.trigger set 1"
            },
            "tooltip": "Toggle the nausea effect given during the teleport animation"
        },
        {
            "label": [{"sprite": "minecraft:mob_effect/night_vision","atlas": "minecraft:gui"},{"text":" Toggle Teleport Flash"}],
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger lstp.menu.trigger set 2"
            },
            "tooltip": "Toggle the blindness effect given after the teleport animation"
        },
        {
            "label": [{"sprite": "minecraft:mob_effect/invisibility","atlas": "minecraft:gui"},{"text":" Toggle Screen Zoom"}],
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger lstp.menu.trigger set 3"
            },
            "tooltip": "Toggle the FOV decrease applied during the teleport animation"
        },
        {
            "label": [{"sprite": "minecraft:item/iron_boots","atlas": "minecraft:items"},{"text":" Toggle Sneak Requirement"}],
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger lstp.menu.trigger set 4"
            },
            "tooltip": "Toggle the sneak requirement to teleport"
        },
        {
            "label": "Destination Name Display...",
            "action": {
                "type": "minecraft:show_dialog",
                "dialog": "lstp:destination_name"
            },
            "tooltip": "Configure where the destination name is displayed"
        }
    ],
    "after_action": "none",
    "pause": false,
    "exit_action": {
        "action": {
            "type": "show_dialog",
            "dialog": "lstp:about"
        },
        "label": {
            "translate": "gui.back"
        },
        "width": 200
    }
}