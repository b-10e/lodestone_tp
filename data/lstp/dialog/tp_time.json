{
    "title": [
        {"translate": "selectWorld.dataPacks","color": "gray"},
        {"text": " > ","color": "dark_gray"},
        {"text": "Lodestone TP","color": "gray"},
        {"text": " > ","color": "dark_gray"},
        {"text": "Server Settings","color": "gray"},
        {"text": " > ","color": "dark_gray"},
        {"text": "Teleportation","color": "white"}
    ],
    "type": "confirmation",
    "inputs": [
        {
            "type": "minecraft:boolean",
            "key": "allow_cross_dimensional_tp",
            "label": "Allow Teleporting Across Dimensions",
            "initial": true,
            "on_true": "true",
            "on_false": "false"
        },
        {
            "label": "Teleport Time",
            "key": "tp_time",
            "type": "minecraft:number_range",
            "initial": 3,
            "start": 0,
            "end": 30,
            "step": 0.5,
            "label_format": "%1$s: %2$s second(s)"
        },
        {
            "label": "Charge Interval",
            "key": "charge_interval",
            "type": "minecraft:number_range",
            "initial": 1,
            "start": 0,
            "end": 10,
            "step": 0.5,
            "label_format": "%1$s: %2$s second(s)"
        }
    ],
    "yes": {
        "label": "Confirm",
        "action": {
            "type": "dynamic/run_command",
            "template": "function lstp:menu/settings/set_tp_time {\"tp_time\":$(tp_time),\"charge_interval\":$(charge_interval),allow_cross_dimensional_tp:\"$(allow_cross_dimensional_tp)\"}"
        }
    },
    "no": {
        "label": {"translate": "gui.back"},
        "action": {
            "type": "show_dialog",
            "dialog": "lstp:server_config"
        }
    },
    "after_action": "none",
    "pause": false
}