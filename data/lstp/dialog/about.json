{
  "type": "minecraft:multi_action",
  "title": "Lodestone TP",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text":"How to use:",
        "color": "white",
        "bold": true
      },
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": "Crouch on a Lodestone while holding\n an Ender Pearl and a Lodestone Compass.",
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text":"Ender Pearls may also be supplied in\na block underneath. A Lodestone Compass may be\nprovided in an Item Frame up to 4 blocks above.",
        "color":"gray"
      },
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "v1.0.0\nBy xokz",
        "color": "gray"
      },
      "width": 300
    }
  ],
  "actions": [
    {
      "label": "Website",
      "action": {
        "type": "open_url",
        "url": "https://github.com/b-10e/lodestone_tp"
      }
    },
    {
      "label": "Issues",
      "action": {
        "type": "open_url",
