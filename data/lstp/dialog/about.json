      }
    },
    {
      "label": "My Settings",
      "action": {
        "type": "show_dialog",
        "dialog": "lstp:client_config"
      }
    },
    {
      "label": "Server Settings",
      "action": {
        "type": "show_dialog",
        "dialog": "lstp:server_config"
      }
    }
  ],
  "exit_action": {
    "action": {
      "type": "show_dialog",
